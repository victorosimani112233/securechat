<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:label="elcim QA"
        tools:replace="android:label">
        <!-- Debug-only physical-device visual QA. MainActivity additionally
             requires FLAG_DEBUGGABLE, so release builds stay fail-closed. -->
        <meta-data
            android:name="com.securechat.DEBUG_ALLOW_SCREEN_CAPTURE"
            android:value="true" />
        <receiver
            android:name=".debug.TestNotificationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.securechat.app.debug.TEST_NOTIFICATION" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
