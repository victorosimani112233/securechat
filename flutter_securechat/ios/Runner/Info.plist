	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>tr</string>
		<string>en</string>
		<string>de</string>
		<string>ar</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>elcim</string>
