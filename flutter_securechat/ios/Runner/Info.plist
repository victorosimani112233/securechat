	<string>Sesli mesaj kaydetmek ve sesli veya goruntulu arama yapmak icin mikrofon erisimi gerekir.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Medya gonderimi icin fotograflara erisim gerekir.</string>
