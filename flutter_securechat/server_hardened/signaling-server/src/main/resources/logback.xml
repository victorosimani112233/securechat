<configuration>
    <conversionRule conversionWord="privacyMessage"
                    converterClass="com.securechat.signaling.PrivacyMessageConverter"/>
    <!--
      Privacy boundary: production verbosity is not runtime-configurable.
      Request/message/call timelines must never become a deployment toggle.
      Only identity-free fatal/storage failures reach ephemeral stdout.
    -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %privacyMessage%n</pattern>
        </encoder>
    </appender>

    <root level="ERROR">
        <appender-ref ref="STDOUT"/>
    </root>

    <!-- Framework request/connection logs may contain routes or peer metadata. -->
    <logger name="io.ktor" level="OFF"/>
    <logger name="io.netty" level="OFF"/>
    <logger name="org.eclipse.jetty" level="OFF"/>
    <logger name="redis.clients.jedis" level="OFF"/>
    <logger name="com.zaxxer.hikari" level="ERROR"/>
</configuration>
