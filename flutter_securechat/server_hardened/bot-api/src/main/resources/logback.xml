<configuration>
    <conversionRule conversionWord="privacyMessage"
                    converterClass="com.securechat.botapi.delivery.BotPrivacyMessageConverter"/>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %privacyMessage%n</pattern>
        </encoder>
    </appender>

    <!-- Fixed privacy boundary; request/send timelines are RAM counters only. -->
    <root level="ERROR">
        <appender-ref ref="STDOUT"/>
    </root>

    <logger name="io.netty" level="OFF"/>
    <logger name="org.eclipse.jetty" level="OFF"/>
    <logger name="redis.clients.jedis" level="OFF"/>
    <logger name="com.zaxxer.hikari" level="ERROR"/>
</configuration>
