# Gelistirme profili — yerel calistirma ve test icin.
#
# Bu profil yalniz ALTYAPI kapilarini gevsetir (HSM, PostgreSQL TLS, SMTP
# TLS, cevrimdisi Sealed Sender sertifikasi). Mesaj gizliligi kapilari her
# profilde aynen calisir: anahtarlar zorunlu ve amac-ayrimli, offline kuyruk
# AEAD ile sifreli, Sealed Sender gercek libsignal.
#
# Production'da ASLA kullanilmaz. `SECURECHAT_PROFILE=development` ile
# `PRIVACY_PRODUCTION_MODE=true` birlikte verilirse sunucu baslamaz.
#
# Anahtarlari uret:
#   for k in PRIVACY_INDEX_KEY OFFLINE_QUEUE_ENCRYPTION_KEY FCM_TOKEN_ENCRYPTION_KEY \
#            SEALED_SENDER_TRUST_ROOT_PRIVATE_KEY SEALED_SENDER_SERVER_PRIVATE_KEY; do
#     echo "$k=$(openssl rand -base64 32)"
#   done

SECURECHAT_PROFILE=development

# --- Zorunlu kriptografik materyal (hepsi birbirinden farkli olmali) ---
JWT_SECRET=
PRIVACY_INDEX_KEY=
OFFLINE_QUEUE_ENCRYPTION_KEY=
FCM_TOKEN_ENCRYPTION_KEY=
TURN_SECRET=
METRICS_BEARER_TOKEN=

# Gelistirmede sertifika process icinde uretilir; production'da bunlarin
# yerini SEALED_SENDER_SERVER_CERTIFICATE + TRUST_ROOT_PUBLIC_KEY alir.
SEALED_SENDER_TRUST_ROOT_PRIVATE_KEY=
SEALED_SENDER_SERVER_PRIVATE_KEY=

# --- Yerel altyapi ---
DATABASE_URL=jdbc:postgresql://127.0.0.1:55440/securechat
DATABASE_USER=securechat
DATABASE_PASSWORD=devpass
REDIS_HOST=127.0.0.1
REDIS_PORT=63790

# OTP akisi kapatilamaz; yerel bir yakalayici (Mailpit) yeterlidir.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=dev@localhost
SMTP_TLS=none

TURN_HOST=127.0.0.1
HOST=127.0.0.1
PORT=8080
