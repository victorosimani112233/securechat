# Elcim send-only mail stack — ornek ortam dosyasi.
# Kopyala: cp .env.mail.example .env.mail  &&  chmod 600 .env.mail

# --- Kimlik -----------------------------------------------------------------
# Gonderici domain'i. SMTP_FROM bu domain'de olmali (SPF/DKIM/DMARC hizasi).
MAIL_DOMAIN=elcim.app

# Mail sunucusunun FQDN'i. UC YERDE AYNI OLMALI:
#   1) bu deger
#   2) A kaydi  mail.elcim.app -> <sunucu IP>
#   3) PTR (reverse DNS) <sunucu IP> -> mail.elcim.app
# Uyusmazsa Gmail/Outlook mesaji reddeder.
MAIL_HOSTNAME=mail.elcim.app

# DKIM selector. Degistirirsen yeni anahtar uretilir ve yeni TXT kaydi gerekir.
DKIM_SELECTOR=mail

# --- Submission kimlik dogrulama --------------------------------------------
# Uygulama sunucusunun postfix'e baglanirken kullandigi SASL kullanicisi.
SMTP_USERNAME=elcim-otp

# Parola DOSYADAN okunur, env'de duz metin durmaz.
#   openssl rand -base64 32 > /etc/elcim/secrets/smtp_password
#   chmod 600 /etc/elcim/secrets/smtp_password
SMTP_PASSWORD_FILE=/etc/elcim/secrets/smtp_password

# --- TLS --------------------------------------------------------------------
# certbot live dizini: fullchain.pem + privkey.pem icermeli.
MAIL_TLS_DIR=/etc/letsencrypt/live/mail.elcim.app

# --- Ag ---------------------------------------------------------------------
# Uygulama stack'inin var olan docker agi.
#   docker network ls  ile dogrula.
# Hardened stack (compose.privacy.yml, project adi securechat-hardened):
APP_NETWORK=securechat-hardened_securechat-egress

# --- Sinirlar ---------------------------------------------------------------
# Dakikada bir istemciden kabul edilecek azami mesaj sayisi.
MAIL_RATE_LIMIT=100
MAIL_MEMORY_LIMIT=256m
MAIL_CPU_LIMIT=0.5

# --- Gonderici adresi (uygulama tarafina da ayni deger girilecek) ------------
SMTP_FROM=noreply@elcim.app

# --- DMARC rapor adresi -----------------------------------------------------
# print-dns-records.sh bu adresi DMARC rua= alanina koyar.
# Bu sunucu mail ALMADIGI icin baska bir kutu ver.
DMARC_RUA=postmaster@elcim.app

# --- Let's Encrypt ----------------------------------------------------------
CERT_EMAIL=sen@ornek.com

# CERTBOT_MODE secenekleri:
#   standalone     80/tcp bos ise (sunucuda, baska web sunucusu yokken)
#   webroot        calisan nginx varsa; NGINX_WEBROOT da ver
#   dns-cloudflare DNS-01. PUBLIC SUNUCU GEREKTIRMEZ — sertifikayi kendi
#                  makinende alabilirsin. VPS almadan test etmek icin bu.
#   dns-manual     DNS-01, TXT'yi elle eklersin. OTOMATIK YENILENEMEZ.
CERTBOT_MODE=standalone
# NGINX_WEBROOT=/var/www/html

# dns-cloudflare modu icin: Zone:DNS:Edit yetkili API token'i.
#   Cloudflare > My Profile > API Tokens > Create Token > Edit zone DNS
#   printf '%s' 'TOKEN' > /etc/elcim/secrets/cloudflare_token
#   chmod 600 /etc/elcim/secrets/cloudflare_token
# CF_API_TOKEN_FILE=/etc/elcim/secrets/cloudflare_token
# CF_PROPAGATION_SECONDS=30

# --- OPSIYONEL: smarthost (relay) -------------------------------------------
# SADECE giden 25/tcp engelliyse doldur. preflight.sh sana soyler.
# Doldurulursa Postfix mailleri bu relay uzerinden gonderir; domain,
# DKIM imzasi ve SPF/DMARC hizasi yine sana ait kalir.
# MAIL_RELAYHOST=[smtp.saglayici.com]:587
# RELAY_USERNAME=
# RELAY_PASSWORD_FILE=/etc/elcim/secrets/relay_password
