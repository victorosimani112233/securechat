# Postfix — send-only transactional mail (OTP).
# Bu dosya bir sablondur; entrypoint.sh yalnizca su degiskenleri doldurur:
#   ${MAIL_HOSTNAME} ${MAIL_DOMAIN} ${DKIM_MILTER} ${MAIL_RATE_LIMIT}
# Postfix'in kendi $degisken referanslari (ornek: $myhostname) dokunulmadan kalir.

compatibility_level = 3.6

# Container'da syslog yok; postlogd stdout'a yazar (master.cf'teki postlog).
maillog_file = /dev/stdout

# --- Kimlik -----------------------------------------------------------------
# myhostname PTR (reverse DNS) kaydiyla BIRE BIR ayni olmali. Aksi halde
# Gmail/Outlook mesaji reddeder ya da spam'e atar.
myhostname = ${MAIL_HOSTNAME}
mydomain = ${MAIL_DOMAIN}
myorigin = $mydomain
smtpd_banner = $myhostname ESMTP

# --- Send-only: hicbir domain icin mail KABUL ETME ---------------------------
# mydestination bos  -> yerel teslim yok
# relay_domains bos  -> relay yok (open relay riski sifir)
mydestination =
relay_domains =
local_transport = error:5.1.1 local delivery is disabled on this send-only host
local_recipient_maps =
alias_maps =
alias_database =

inet_interfaces = all
inet_protocols = ipv4

# mynetworks bilerek DAR tutuluyor: docker subnet'i guvenilir sayilmaz,
# yetkilendirme yalnizca SASL ile yapilir (master.cf submission bloguna bak).
mynetworks = 127.0.0.0/8 [::1]/128

# --- Submission (587) TLS ---------------------------------------------------
# Sertifika ${MAIL_HOSTNAME} icin gecerli olmali: uygulama tarafindaki
# jakarta.mail `mail.smtp.starttls.required=true` ile hostname dogrular.
smtpd_tls_cert_file = /etc/postfix/certs/fullchain.pem
smtpd_tls_key_file = /etc/postfix/certs/privkey.pem
smtpd_tls_security_level = encrypt
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_ciphers = high
smtpd_tls_loglevel = 1
tls_preempt_cipherlist = yes
tls_ssl_options = NO_COMPRESSION, NO_RENEGOTIATION

# --- SASL (Cyrus / sasldb2) -------------------------------------------------
# Global kapali; sadece submission listener'inda aciliyor.
smtpd_sasl_auth_enable = no
smtpd_sasl_type = cyrus
smtpd_sasl_path = smtpd
smtpd_sasl_local_domain = ${MAIL_DOMAIN}
smtpd_sasl_security_options = noanonymous
smtpd_sasl_tls_security_options = noanonymous
broken_sasl_auth_clients = no

# --- Giden TLS (uzak MX'e) --------------------------------------------------
# `may` = opportunistic. `encrypt` yapmak, TLS desteklemeyen alici MX'lere
# OTP gonderimini tamamen keser; OTP akisi icin dogru secim `may`.
smtp_tls_security_level = may
smtp_tls_mandatory_protocols = >=TLSv1.2
smtp_tls_protocols = >=TLSv1.2
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
smtp_tls_loglevel = 1
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache

# HELO adi PTR ile ayni olmali.
smtp_helo_name = $myhostname

# --- DKIM imzalama (OpenDKIM milter) ----------------------------------------
# milter_default_action=tempfail: OpenDKIM cokerse mesaj IMZASIZ gitmez,
# kuyrukta bekler. Imzasiz cikan mail DMARC'tan doner ve IP itibarini yakar.
milter_default_action = tempfail
milter_protocol = 6
smtpd_milters = inet:${DKIM_MILTER}
non_smtpd_milters = inet:${DKIM_MILTER}

# --- Sertlestirme / kotuye kullanim sinirlari -------------------------------
disable_vrfy_command = yes
smtpd_helo_required = yes
message_size_limit = 1048576
mailbox_size_limit = 0
smtpd_client_connection_count_limit = 20
smtpd_client_connection_rate_limit = 60
smtpd_client_message_rate_limit = ${MAIL_RATE_LIMIT}
anvil_rate_time_unit = 60s

# --- Kuyruk / bounce --------------------------------------------------------
# OTP kisa omurlu: 1 saatte teslim edilemeyen kod zaten gecersiz.
maximal_queue_lifetime = 1h
# 0 = teslim edilemeyen bounce (NDR) mesajlarini hemen at.
# Bu host mail ALMADIGI icin noreply@ adresine donen NDR hicbir zaman
# teslim edilemez; kuyrukta birikmesin. Basarisizlik zaten loglanir.
bounce_queue_lifetime = 0
notify_classes = resource, software

# Postfix chroot kullanmiyor (master.cf'te tum servisler chroot=n),
# boylece /etc/sasldb2 ve CA store'a dogrudan erisilir.
queue_directory = /var/spool/postfix
data_directory = /var/lib/postfix
