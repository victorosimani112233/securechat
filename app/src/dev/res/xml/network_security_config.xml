<?xml version="1.0" encoding="utf-8"?>
<!--
  DEV flavor override: dev sunucu IP'lerine cleartext erisim.
  Production build (prod flavor) bu dosyayi gormez, src/main/res/xml versiyonunu kullanir
  (cleartextTrafficPermitted=false, sadece TLS).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Sadece dev sunucu IP'leri ve emulator host'una cleartext izin -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.4.10.12</domain>
        <domain includeSubdomains="false">185.48.182.124</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
