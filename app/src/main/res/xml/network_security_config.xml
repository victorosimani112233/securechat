<?xml version="1.0" encoding="utf-8"?>
<!--
  Production network policy: cleartextTrafficPermitted=false (sadece TLS).
  Dev flavor'da debug build varsa user CA cert'leri kabul edilir (Charles, mitmproxy vs).
  Dev sunucu IP'leri buraya degil, dev flavor'in kendi src/dev/res/xml/network_security_config.xml'ine yazilir.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
