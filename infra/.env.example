# SecureChat Production Environment
# Bu dosyayi .env olarak kopyalayip degerleri doldurun:
#   cp .env.example .env
#
# Guclu secret uretmek icin:
#   openssl rand -base64 48

# PostgreSQL
POSTGRES_PASSWORD=

# Redis
REDIS_PASSWORD=

# TURN sunucusu HMAC secret (dinamik credential icin)
# En az 32 karakter; bos olamaz, server fail-fast yapar.
TURN_SECRET=

# JWT signing secret (kullanici authentication tokenleri imzalanir)
# En az 32 karakter; bos olamaz, server fail-fast yapar.
JWT_SECRET=

# --- SMTP (kendi mail sunucun) ---
# Bu degerler bos birakilirsa OTP zorunlu degildir (development modu).
# Production'da MUTLAKA doldurun.
SMTP_HOST=mail.securechat.com
SMTP_PORT=587
SMTP_USERNAME=noreply@securechat.com
SMTP_PASSWORD=
SMTP_FROM=noreply@securechat.com
SMTP_TLS=starttls   # starttls, ssl, veya none

# Janus SFU API secret (opsiyonel — yoksa default kullanilir)
JANUS_API_SECRET=

# Log seviyesi: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# Graceful shutdown drain suresi (saniye)
SHUTDOWN_DRAIN_SECONDS=30

# Ortam (production | development)
ENV=production

# =============================================================================
# Bot API (send-only otomasyon endpoint'i — ayri container, internal-only)
# =============================================================================

# 32 byte base64 — bot identity private key'i AES-256-GCM ile sarar.
# Uretmek icin: openssl rand -base64 32
# UYARI: Bu key kaybolursa bot'un Signal oturumlari geri donulemez sekilde
# kaybolur (recipient'lar "identity changed" uyarisi gorur). KESINLIKLE
# escrow yapin: env + admin GPG ile sifreli offline backup.
BOT_MASTER_KEY=

# 32+ karakter random — admin endpoint'lere erisim icin X-Admin-Token degeri.
# Uretmek icin: openssl rand -hex 32
BOT_ADMIN_TOKEN=

# Bot-api log seviyesi (default: INFO)
BOT_LOG_LEVEL=INFO
