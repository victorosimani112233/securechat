general: {
	#configs_folder = "/etc/janus"
	#plugins_folder = "/usr/lib/janus/plugins"
	#transports_folder = "/usr/lib/janus/transports"
	log_to_stdout = true
	debug_level = 4
	admin_secret = "janusoverlord"
	api_secret = "securechat_janus_api"
	server_name = "SecureChat Janus SFU"
}

media: {
	rtp_port_range = "20000-20200"
	dtls_mtu = 1200
}

nat: {
	stun_server = "185.48.182.124"
	stun_port = 3478
	nice_debug = false
	full_trickle = true
	ice_lite = true
	# TURN server konfigurasyonu
	turn_server = "185.48.182.124"
	turn_port = 3478
	turn_type = "udp"
}

plugins: {
	disable = "libjanus_textroom.so,libjanus_recordplay.so,libjanus_sip.so,libjanus_nosip.so,libjanus_streaming.so,libjanus_audiobridge.so,libjanus_echotest.so,libjanus_voicemail.so"
}
