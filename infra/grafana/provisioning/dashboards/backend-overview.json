{
  "dashboard": {
    "id": null,
    "uid": "securechat-backend",
    "title": "SecureChat Backend",
    "tags": ["securechat"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "WebSocket Baglanti Sayisi",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [{"expr": "securechat_ws_connections_active", "legendFormat": "Aktif"}]
      },
      {
        "id": 2,
        "title": "Mesaj/sn",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [{"expr": "rate(securechat_messages_total[1m])", "legendFormat": "{{type}}"}]
      },
      {
        "id": 3,
        "title": "HTTP Latency (p99)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [{"expr": "histogram_quantile(0.99, rate(securechat_http_duration_seconds_bucket[5m]))", "legendFormat": "p99"}]
      },
      {
        "id": 4,
        "title": "Hata Orani",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [{"expr": "rate(securechat_errors_total[5m])", "legendFormat": "Hata/sn"}]
      },
      {
        "id": 5,
        "title": "Offline Kuyruk Boyutu (Redis)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [{"expr": "securechat_offline_queue_size", "legendFormat": "Mesaj"}]
      },
      {
        "id": 6,
        "title": "DB Connection Pool",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [
          {"expr": "securechat_db_pool_active", "legendFormat": "Aktif"},
          {"expr": "securechat_db_pool_idle", "legendFormat": "Idle"},
          {"expr": "securechat_db_pool_pending", "legendFormat": "Bekleyen"}
        ]
      }
    ],
    "time": {"from": "now-1h", "to": "now"},
    "refresh": "10s"
  }
}
